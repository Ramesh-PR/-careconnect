# ==============================================================================
# CareConnect – Supabase Environment Variables
# ==============================================================================
# WHERE TO FIND THESE VALUES IN SUPABASE:
# 1. Open https://supabase.com/dashboard and select your project.
# 2. Click "Project Settings" (Gear icon at bottom of left sidebar) -> "API".
# 3. Copy "Project URL" and paste it into VITE_SUPABASE_URL below.
# 4. Copy the "anon" / "public" (or publishable) key and paste it into VITE_SUPABASE_ANON_KEY.
#
# SECURITY WARNING:
# NEVER put your Supabase "service_role" or "secret" key in this file or anywhere
# in your React frontend code! Only the publishable/anon key is safe for browsers.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-public-key

